    "Are you sure you want to abandon this transaction?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie diese Transaktion aufgeben wollen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que deseas abandonar esta transacción?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir abandonner cette transaction ?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czy na pewno chcesz zrezygnować z tej transakcji?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви впевнені, що хочете провалити цю транзакцію?"
          }
        }
      }
    },
    "Are you sure you want to abort this transaction?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie diese Transaktion abbrechen wollen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Seguro que deseas cancelar esta transacción?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
