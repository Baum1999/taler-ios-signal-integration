          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо у вас немає рахунку в швейцарському банку, ви можете просто спробувати демо-версію..."
          }
        }
      }
    },
    "If you have already sent money to the payment service, it will wire it back in %llu days." : {
      "localizations" : {
        "de" : {
