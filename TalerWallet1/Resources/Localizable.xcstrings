          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви впевнені, що хочете скасувати цю транзакцію?"
          }
        }
      }
    },
    "Are you sure you want to delete this transaction?" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass Sie diese Transaktion löschen wollen?"
          }
        },
        "es" : {
          "stringUnit" : {
