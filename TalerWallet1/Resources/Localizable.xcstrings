          "stringUnit" : {
            "state" : "translated",
            "value" : "activée lorsque le montant est différent de zéro"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "włączone, gdy kwota jest niezerowa"
          }
        }
      }
    },
    "enabled when amount is non-zero, but not higher than your available amount" : {
      "comment" : "a11y",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "aktiviert, wenn der Betrag ungleich Null ist, aber nicht höher als Ihr verfügbarer Betrag"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "habilitado cuando el monto no es cero ni más alto que el monto disponible"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "activé lorsque le montant est différent de zéro, mais ne dépasse pas le montant disponible"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "włączona, gdy kwota jest niezerowa, ale nie wyższa niż dostępna kwota"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "доступно, коли сума не дорівнює нулю, але не перевищує доступну суму"
          }
        }
      }
    },
    "enabled when subject and expiration are set" : {
