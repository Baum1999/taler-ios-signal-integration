          }
        }
      }
    },
    "If you don't have a Swiss bank account, you can simply try out the demo…" : {
      "comment" : "A description of how to use the demo feature if the user doesn't have a Swiss bank account.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie kein Schweizer Bankkonto haben, können Sie einfach die Demo ausprobieren..."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si no tienes una cuenta bancaria en Suiza, puedes probar la demo..."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous n'avez pas de compte bancaire suisse, vous pouvez simplement essayer la démo..."
