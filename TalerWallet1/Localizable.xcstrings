          "stringUnit" : {
            "state" : "translated",
            "value" : "Постачальник платіжних послуг чекає на ваш банківський переказ."
          }
        }
      }
    },
    "The withdrawal was aborted.\nIf you have already sent money to the exchange, it will wire it back in %@ days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
