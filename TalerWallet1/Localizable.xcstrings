        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зняття коштів було скасовано. Якщо ви вже відправили гроші на обмінник, він поверне їх протягом %@ днів."
          }
        }
      }
    },
    "There are no Payment Services yet." : {
