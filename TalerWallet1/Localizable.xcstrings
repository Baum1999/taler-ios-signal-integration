            "value" : "Der Zahlungsdienst sendet Ihr Geld zurück wenn es nicht rechtzeitig abgerufen wird, oder wenn Sie die Operation abbrechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El servicio de pagos te regresará el dinero si no recibe tu pago a tiempo, o si decides cancelar la operación."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usługa płatności odeśle pieniądze, jeśli nie zostaną one pobrane na czas lub jeśli przerwiesz operację."
          }
        }
      }
    },
    "The withdrawal was aborted.\nIf you have already sent money to the exchange, it will wire it back in %@ days." : {
