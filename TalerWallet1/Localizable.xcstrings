          "stringUnit" : {
            "state" : "translated",
            "value" : "Erklärung der Aktionen-Taste"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explicar el botón de acciones"
          }
        },
        "pl" : {
          "stringUnit" : {
